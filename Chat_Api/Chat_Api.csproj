<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LaunchBrowser>true</LaunchBrowser>
    <LaunchUrl>swagger</LaunchUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chat.Application\Chat.Application.csproj" />
    <ProjectReference Include="..\Chat.Domain\Chat.Domain.csproj" />
    <ProjectReference Include="..\Chat.Infrastructure\Chat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
    <Folder Include="Helpers\" />
    <Folder Include="Hubs\" />
    <Folder Include="Models\" />
    <Folder Include="wwwroot\chat-attachments\" />
  </ItemGroup>

  <!-- Backup stop for this web host (also covered by Directory.Build.targets). -->
  <Target Name="StopChatApiHostBeforeBuild" BeforeTargets="BeforeBuild">
    <Exec
      Command="taskkill /F /IM Chat_Api.exe /T &gt;nul 2&gt;&amp;1 &amp; exit /B 0"
      IgnoreExitCode="true"
      ContinueOnError="true"
      Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

</Project>
